{
  "name": "automock-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/cli.ts serve specs/petstore.json",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint:security": "node scripts/security-lint.ts",
    "verify": "npm run typecheck && npm run lint:security && npm test",
    "agent:daily": "node agents/harness.ts",
    "agent:dry": "DRY_RUN=1 node agents/harness.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.8.0"
  }
}
